# Client Configuration
# In production, set to your deployed backend URL, e.g. https://api.smartscanpay.com/api/v1
# In local development with Vite proxy, leave empty or set to /api/v1 or http://localhost:5000/api/v1
VITE_API_URL=http://localhost:5000/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Razorpay Key ID (public test key for client checkout)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
